{
  "id": "FEAT-WORD-EXPORT",
  "capability": "word",
  "version": 1,
  "required_evidence": [
    "E1",
    "E2",
    "E3",
    "E4",
    "E5"
  ],
  "required_checks": [
    "artifact_integrity",
    "wps_consumer",
    "formula_fidelity",
    "no_consumer_error"
  ],
  "completion_policy": {
    "unknown_max": 1,
    "blocking_unknown": [],
    "wps_consumer_required": true,
    "formula_fidelity_required": true,
    "parse_error_max": 0
  },
  "s0_unsupported": [
    "microsoft_word_desktop"
  ],
  "note": "word 导出能力复用 docx_qa（ffx analyze audit）：OOXML/rels/语义 + WPS consumer（word2pdf/pdfinfo/pdf2txt）+ OfficeCLI（screenshot/issues）。公式保真（formula_fidelity）为 DOGFOOD-RUN-004 修复后字段——docx 内部 latex fallback 必须出现在消费端文本（产物成功≠功能正确）。MS Word Desktop 为 S0 声明边界（Level C Release Gate，需 Word 环境才验证）。",
  "evidence_profile": {
    "E2": "required",
    "E3": "required",
    "E5": "required",
    "E6": "release-gate"
  },
  "support_policy": {
    "required": [
      "artifact_integrity",
      "wps_consumer",
      "formula_fidelity"
    ],
    "optional": [],
    "unsupported": [
      "microsoft_word_desktop"
    ]
  },
  "fingerprint": {
    "version": 2,
    "fields": [
      "capability",
      "failing_check",
      "failure_class",
      "evidence_signature"
    ]
  },
  "evidence_strength": {
    "enum": [
      "synthetic",
      "test_runtime",
      "production_runtime",
      "physical_runtime",
      "visual",
      "human_confirmed"
    ],
    "achieved": [
      "synthetic",
      "production_runtime"
    ],
    "note": "Evidence Strength（评审 §2 修正）：policy-defined ordering（非普适全序——visual 与 human_confirmed 是 release policy 定义的最低证明能力阶梯，非天然 epistemic hierarchy）。achieved=实际获得的证据，minimum_required=release gate 要求（二者分离）。",
    "minimum_required": "production_runtime"
  }
}
