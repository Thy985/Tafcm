{
  "id": "FEAT-MD-SERIALIZE",
  "capability": "serializer",
  "version": 1,
  "required_evidence": [
    "E1",
    "E2",
    "E3"
  ],
  "required_checks": [
    "serialize",
    "roundtrip",
    "no_parse_error"
  ],
  "completion_policy": {
    "unknown_max": 5,
    "blocking_unknown": [],
    "roundtrip_convergence_min": 0.99,
    "parse_error_max": 0
  },
  "s0_unsupported": [
    "autolink",
    "footnote",
    "definition_list",
    "indented_code",
    "raw_html_块"
  ],
  "note": "serializer 能力复用 runner 的 round-trip 指标（parse→serialize→parse 收敛）；与 markdown 共享同一 runner，但 required_checks 聚焦序列化保真（serialize / roundtrip / no_parse_error）——跨能力回归对比的第 2 个 capability。",
  "evidence_profile": {
    "E2": "required",
    "E3": "required",
    "E5": "recommended",
    "E6": "conditional"
  },
  "support_policy": {
    "required": [
      "serialize",
      "roundtrip",
      "no_parse_error"
    ],
    "optional": [],
    "unsupported": [
      "autolink",
      "footnote",
      "definition_list",
      "indented_code",
      "raw_html_块"
    ]
  },
  "fingerprint": {
    "version": 2,
    "fields": [
      "capability",
      "failing_check",
      "failure_class",
      "evidence_signature"
    ]
  },
  "evidence_strength": {
    "enum": [
      "synthetic",
      "test_runtime",
      "production_runtime",
      "physical_runtime",
      "visual",
      "human_confirmed"
    ],
    "achieved": [
      "synthetic",
      "test_runtime",
      "production_runtime"
    ],
    "note": "Evidence Strength（评审 §2 修正）：policy-defined ordering（非普适全序——visual 与 human_confirmed 是 release policy 定义的最低证明能力阶梯，非天然 epistemic hierarchy）。achieved=实际获得的证据，minimum_required=release gate 要求（二者分离）。",
    "minimum_required": "production_runtime"
  }
}
