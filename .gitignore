# ============================================================================
# Tafcm — Root .gitignore
# ============================================================================
# Established by chore(restore-root-gitignore) PR.
# Each rule must have a stated reason; see commit message.
# ============================================================================

# === Flutter / Dart ===
**/build/
**/.dart_tool/
**/.flutter-plugins
**/.flutter-plugins-dependencies
# Note: pubspec.lock 是 App 不提交 / 库提交——根 .gitignore 不能跨子 .gitignore 屏蔽
# 子目录的 .gitignore 优先解析（git 标准行为），故此规则写在 flutter_app/.gitignore（PR-2 处理）
flutter_app/.idea/
flutter_app/*.iml
flutter_app/android/app/build/
flutter_app/android/.idea/
flutter_app/ios/Flutter/Flutter.framework
flutter_app/ios/Flutter/Flutter.podspec
flutter_app/ios/Flutter/.last_build_id
**/doc/api/

# === Android / iOS generated ===
**/.gradle/
**/local.properties
**/Pods/
**/.symlinks/

# === Python toolchain ===
**/.pytest_cache/
**/__pycache__/
**/*.pyc

# === Agent / runtime artifacts ===
.agent/state/
.adi/
.ffx/
.workbuddy/
.wt/
.arts/
.codeartsdoer/
.atomcode/
debug/
openwiki/

# === Local / generated logs ===
**/*.local.log
**/logs/
.claude/hooks.log

# === Flutter test artifacts ===
flutter_app/test/golden/failures/

# === Root-level OpenWiki mirror (avoid double-source with AGENTS.md) ===
# CLAUDE.md is the OpenWiki-suggested entrypoint; AGENTS.md already has the
# OPENWIKI block appended by the GitHub Action. Ignore CLAUDE.md to prevent
# divergence between the two sources.
/CLAUDE.md

# === One-shot debug artifacts (AGENTS.md §6.2.6 / §6.2.12) ===
# Root /ui_dump.xml and flutter_app/ui_dump.xml are one-time Android
# uiautomator dump outputs from E2E validation. They are tracked in HEAD
# historically; PR-2 will git rm both copies. **/ui_dump.xml prevents
# future regeneration from being re-added.
# Note: cannot be verified with check-ignore while files are tracked;
# PR-2 (after git rm) re-verifies.
**/ui_dump.xml

# === Workflow runtime temp dir (tafcm-maintainer) ===
# .tmp/ 由 tafcm-maintainer.yml 的 Cline / report 步骤创建（运行时产物），
# 不入库；Guard 步骤用 git status --porcelain 检查越权变更，若不忽略会误判。
.tmp/

# === Firebase 凭据与运行产物（AGENTS.md §6.2.4 禁含密钥文件入库） ===
# google-services.json 含 Firebase 客户端凭据（project_number / mobilesdk_app_id /
# api_key），任何环境均不得入库。.firebaserc / firebase.json 为 Firebase CLI
# 项目绑定与托管配置，属本地开发环境态。firebase-debug.log 为 CLI 一次性运行日志。
**/google-services.json
.firebaserc
firebase.json
**/firebase-debug.log

# === 本地诊断/IDE 一次性产物 ===
# 真机/模拟器导出死循环诊断 dump（.diag-*）、IDE 本地配置（.vscode）为开发者
# 各自机器的一次性/环境态文件，不入库。
/.diag-*/
/.vscode/

# === 本地代理环境脚本 ===
# tools/upload002.sh 内含硬编码本地代理地址（HTTPS_PROXY=127.0.0.1:7897），
# 属开发者机器环境态，不入库。
tools/upload002.sh
